{
  "network": "192.168.1.0/24",
  "interval_sec": 300,
  "notify_vanished": false,
  "os_detection": false,
  "enrich": {
    "enabled": true,
    "reverse_dns": true,
    "ping_ttl": true,
    "compare_gateway": true
  },
  "ids": {
    "enabled": true,
    "watch_known": true,
    "rescan_every": 2,
    "gateway_watch": true,
    "suspicious_ports": [21, 23, 445, 3389, 5555, 5060],
    "timeout_sec": 120,
    "known_scan_args": ["-sT", "--top-ports", "100"]
  },
  "port_scan": {
    "enabled": true,
    "args": ["-sV", "--top-ports", "100"],
    "timeout_sec": 120
  },
  "web": {
    "port": 8080,
    "bind": "0.0.0.0"
  },
  "telegram": {
    "bot_token": "COLLE_ICI_LE_TOKEN_DE_TON_BOT",
    "chat_id": "COLLE_ICI_TON_CHAT_ID"
  }
}
